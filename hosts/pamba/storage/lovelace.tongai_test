                {
                  "type": "markdown",
                  "title": "Current Schedule",
                  "content": "{% set s = state_attr('sensor.alarm_mode', 'mode') %} {% set season = state_attr('sensor.alarm_mode', 'season') %} {% set sunrise = state_attr('sensor.alarm_mode', 'sunrise') %} {% set sunset = state_attr('sensor.alarm_mode', 'sunset') %} {% set wakeup = state_attr('sensor.alarm_mode', 'wakeup') %} {% set evening = state_attr('sensor.alarm_mode', 'evening') %} {% set bedtime = state_attr('sensor.alarm_mode', 'bedtime') %} {% set nighttime = state_attr('sensor.alarm_mode', 'nighttime') %}\n| | | |:--|:--| | **Mode** | {{ s | upper if s else 'Unknown' }} | | **Season** | {{ season | title if season else '—' }} | | **Sunrise** | {{ sunrise or '—' }} | | **Sunset** | {{ sunset or '—' }} | | **Wakeup** | {{ wakeup or '—' }} | | **Evening** | {{ evening or '—' }} | | **Bedtime** | {{ bedtime or '—' }} | | **Nighttime** | {{ nighttime or '—' }} |"
                }
