                            "top": "29.7%",
                            "background": "var(--card-background-color)",
                            "border-radius": "50%",
                            "padding": "2px",
                            "color": "var(--error-color)",
                            "--mdc-icon-size": "30px"
                          }
                        }
                      ]
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "numeric_state",
                          "entity": "sensor.m_bedside_light_battery_level",
                          "below": 10
                        }
                      ],
                      "elements": [
                        {
                          "type": "icon",
                          "icon": "mdi:battery-alert-variant-outline",
                          "entity": "sensor.m_bedside_light_battery_level",
                          "tap_action": {
                            "action": "more-info"
                          },
                          "hold_action": {
                            "action": "more-info"
                          },
                          "style": {
                            "left": "62.9%",
                            "top": "36.2%",
                            "background": "var(--card-background-color)",
                            "border-radius": "50%",
                            "padding": "2px",
                            "color": "var(--error-color)",
                            "--mdc-icon-size": "30px"
                          }
                        }
                      ]
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "numeric_state",
                          "entity": "sensor.closed_l_battery",
                          "below": 10
                        }
                      ],
                      "elements": [
                        {
                          "type": "icon",
