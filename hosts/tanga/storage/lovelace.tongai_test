          "type": "masonry",
          "path": "door-auth",
          "title": "Door Auth",
          "icon": "mdi:fingerprint",
          "cards": [
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "binary_sensor.fp_button_a",
                  "name": "Button A"
                },
                {
                  "entity": "binary_sensor.fp_button_b",
                  "name": "Button B"
                },
                {
                  "entity": "sensor.fp_authentication_status",
                  "name": "FP Status"
                }
              ],
              "title": "Status"
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "markdown",
                  "content": "## Enrolled Fingerprints\n| ID | Name | Finger |\n|----|------|--------|  {% set fpdb = states('input_text.fp_metadata_store').split(';') %} {% for entry in fpdb if entry %}\n  {% set data = entry.split(':') %}\n  {% if data|length == 3 %}\n  | {{ data[0] }} | {{ data[1] }} | {{ data[2] }} |\n{% endif %} {% endfor %}\n**Fingerprints stored in device:** {{ states('sensor.c3_stored_fingerprints') }}\n"
                }
              ]
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "entities",
                  "title": "Enroll Fingerprint",
                  "entities": [
                    {
                      "entity": "sensor.fp_authentication_status",
                      "name": "FP Status",
                      "icon": "mdi:state-machine"
                    },
                    {
                      "type": "divider"
                    },
                    {
                      "entity": "input_text.fp_enroll_name",
                      "name": "Person Name",
                      "icon": "mdi:account"
                    },
                    {
                      "entity": "input_select.fp_enroll_finger",
                      "name": "Finger Selection",
                      "icon": "mdi:hand-back-left"
                    },
                    {
                      "type": "divider"
                    },
                    {
                      "type": "button",
                      "action_name": "press",
                      "tap_action": {
                        "action": "call-service",
                        "service": "input_button.press",
                        "target": {
                          "entity_id": "input_button.enroll_fingerprint"
                        }
                      },
                      "name": "Enroll Fingerprint",
                      "icon": "mdi:fingerprint",
                      "show_state": true
                    }
                  ]
                }
