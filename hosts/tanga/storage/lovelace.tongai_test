              "state_color": true
            },
            {
              "type": "custom:auto-entities",
              "card": {
                "type": "glance",
                "title": "What's Open",
                "state_color": true,
                "columns": 2,
                "show_header_toggle": true,
                "show_state": false,
                "show_friendly_name": true
              },
              "filter": {
                "include": [
                  {
                    "domain": "binary_sensor",
                    "state": "on",
                    "entity_id": "*_contact"
                  },
                  {
                    "domain": "binary_sensor",
                    "state": "on",
                    "entity_id": "*evie*closed*"
                  },
                  {
                    "domain": "binary_sensor",
                    "state": "on",
                    "entity_id": "*evie*door*lock*"
                  }
                ],
                "exclude": [
                  {
                    "entity_id": "*doorstep*"
                  }
                ]
              },
              "sort": {
                "method": "last_changed",
                "reverse": false
              },
              "show_empty": true
            },
            {
              "type": "custom:auto-entities",
              "card": {
                "type": "entities",
                "title": "What's On",
                "state_color": true,
                "columns": 2,
                "show_header_toggle": true,
                "show_state": false,
                "show_friendly_name": true
              },
              "filter": {
                "include": [
                  {
                    "domain": "light",
                    "state": "on"
                  },
                  {
                    "domain": "switch",
                    "group": "group.downstairs_lights",
                    "state": "on"
                  }
                ],
                "exclude": [
                  {
                    "entity_id": "light.linkplus_led"
                  }
                ]
              },
              "sort": {
                "method": "last_changed",
                "reverse": false
              },
              "tap_action": {
                "action": "toggle"
              }
            },
            {
              "title": "Alarm Panel",
