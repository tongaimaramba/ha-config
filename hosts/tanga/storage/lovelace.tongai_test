              ],
              "title": "What's happing in the study?"
            },
            {
              "type": "picture-entity",
              "entity": "camera.camera"
            },
            {
              "columns": 2,
              "entities": [
                {
                  "entity": "script.study_boost",
                  "icon": "mdi:rocket",
                  "name": "Boost Heating",
                  "tap_action": {
                    "action": "toggle"
                  },
                  "show_state": true
                },
                {
                  "entity": "input_select.room_heater",
                  "name": "Boosted Room",
                  "show_state": false
                }
              ],
              "title": "Heating",
              "type": "entities",
              "state_color": true
            },
            {
              "type": "entities",
              "entities": [
                {
                  "type": "custom:config-template-card",
                  "entities": [
                    "sensor.hannah_locator"
                  ],
                  "variables": {
                    "LOC": "states['sensor.hannah_locator'].attributes.map_link",
                    "PLC": "states['sensor.hannah_locator'].attributes.place_name",
                    "STA": "states['sensor.hannah_locator'].state"
                  },
                  "row": {
                    "type": "weblink",
                    "url": "${LOC}",
                    "name": "${PLC === undefined ? 'Hannah is at '+STA : 'Hannah is at '+PLC}",
                    "icon": "mdi:map-marker-account"
                  }
                },
                {
                  "entity": "sensor.hannah_locator",
