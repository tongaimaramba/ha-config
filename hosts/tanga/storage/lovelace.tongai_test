            {
              "type": "entities",
              "entities": [
                {
                  "type": "custom:config-template-card",
                  "entities": [
                    "sensor.hannah_locator"
                  ],
                  "variables": {
                    "LOC": "states['sensor.hannah_locator'].attributes.map_link",
                    "PLC": "states['sensor.hannah_locator'].attributes.place_name",
                    "STA": "states['sensor.hannah_locator'].state"
                  },
                  "row": {
                    "type": "weblink",
                    "url": "${LOC}",
                    "name": "${PLC === undefined ? 'Hannah is at '+STA : 'Hannah is at '+PLC}",
                    "icon": "mdi:map-marker-account"
                  }
                },
                {
                  "entity": "sensor.hannah_locator",
                  "type": "attribute",
                  "attribute": "last_changed",
                  "name": "There since: ",
                  "icon": "mdi:clock"
                },
                {
                  "entity": "sensor.hannah_locator",
                  "type": "attribute",
                  "attribute": "distance_from_home_mi",
                  "suffix": "miles",
                  "name": "Distance from home is about: ",
                  "icon": "mdi:home-circle"
