                    "action": "call-service",
                    "service": "rest_command.navimow_start"
                  }
                },
                {
                  "type": "button",
                  "name": "Stop Immediately",
                  "tap_action": {
                    "action": "call-service",
                    "service": "rest_command.navimow_stop"
                  }
                },
                {
                  "type": "button",
                  "name": "Return to Base",
                  "tap_action": {
                    "action": "call-service",
                    "service": "rest_command.navimow_return"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "entity": "binary_sensor.oppy_online",
                      "state": "off"
                    }
                  ],
                  "card": {
                    "type": "markdown",
                    "content": "**Warning:** Oppy is offline. Check power and network connection."
                  }
                },
                {
                  "type": "history-graph",
                  "entities": [
                    "sensor.oppy_battery"
                  ],
                  "hours_to_show": 24,
                  "refresh_interval": 300
                }
              ]
            }
          ]
        }
